---
import '../../../styles/components/show-editorial.css';
import Layout from '../../../layouts/Layout.astro';
import AutoGallery from '../../../components/AutoGallery.astro';
import { getEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const galleryDir = path.join(process.cwd(), 'public', 'img', 'matrimonio');

const galleryImages = fs.existsSync(galleryDir)
  ? fs.readdirSync(galleryDir, { withFileTypes: true })
      .filter((entry) => entry.isFile() && /\.(jpe?g|png|webp|avif)$/i.test(entry.name))
      .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }))
      .map((entry) => ({
        src: `/img/matrimonio/${entry.name}`,
        alt: 'Il matrimonio',
      }))
  : [];

const bandImage =
  galleryImages[2]?.src ??
  galleryImages[1]?.src ??
  galleryImages[0]?.src ??
  '/img/matrimonio02.jpg';
const finalGallery = galleryImages
  .filter((_, index) => index !== 2)
  .slice(0, 3);

// MATRIMONIO_RELATED_ALBUMS_START
const relatedAlbumSlug = 'matrimonio/studiumlab-prove-2026-05-22';
const relatedAlbumDir = path.join(process.cwd(), 'public', 'img', relatedAlbumSlug);

const relatedAlbumCaptions: Record<string, string> = {
  'ambasciatore.jpg': 'Stefano Martelli, Eleonora Congiu, Aurora Sempio, Arturo Gerace, Viola Cicoria, Anita Masi, Giulia Tonello, Francesca Tomalino, Camilla Rizzo, Pablo Comune, Siyuan Chen, Giorgio Zaccarelli, Gabriela Checcia. Fotografia: Alessio Dell’Anna',
  'aurora-sempio.jpg': 'Aurora Sempio. Fotografia: Alessio Dell’Anna',
  'cortei.jpg': 'Davanti: Camilla Rizzo, Francesca Tomalino, Anita Masi. Fotografia: Alessio Dell’Anna',
  'genitori.jpg': 'Gabriela Checchia, Pablo Comune. Fotografia: Alessio Dell’Anna',
  'giannetto.jpg': 'Eleonora Congiu. Fotografia: Alessio Dell’Anna',
  'lucista.jpg': 'Marco Usmigli. Fotografia: Alessio Dell’Anna',
  'regista.jpg': 'Leonardo Mancini. Fotografia: Alessio Dell’Anna',
  'ripasso.jpg': 'Fotografia: Alessio Dell’Anna',
  'studio-testo.jpg': 'Olivia Del Sante. Fotografia: Alessio Dell’Anna',
  'testo-ubriaco.jpg': 'Fotografia: Alessio Dell’Anna',
  'tradimento.jpg': 'Siyuan Chen, Francesca Tomalino, Gabriele Vaschetti, Arturo Gerace. Fotografia: Alessio Dell’Anna',
  'ubriaco.jpg': 'Stefano Martelli. Fotografia: Alessio Dell’Anna',
  'vescovo.jpg': 'Francesca Tomalino, Giulia Tonello, Camilla Rizzo, Gabriela Checchia, Arturo Gerace. Fotografia: Alessio Dell’Anna',
};

const relatedAlbumImages = fs.existsSync(relatedAlbumDir)
  ? fs
      .readdirSync(relatedAlbumDir)
      .filter((file) => /\.(jpe?g|png|webp|avif)$/i.test(file))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }))
      .map((file) => ({
        src: `/img/${relatedAlbumSlug}/${file}`,
        alt:
          relatedAlbumCaptions[file] ||
          file.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').trim(),
      }))
  : [];

const relatedAlbumCover =
  relatedAlbumImages.find((image) => image.src.endsWith('/ripasso.jpg')) ||
  relatedAlbumImages[0];
// MATRIMONIO_RELATED_ALBUMS_END


const matrimonioCmsEntry = await getEntry('work', 'matrimonio');
const cmsDuration = matrimonioCmsEntry?.data.duration ?? '75 minuti';
const cmsTitle = matrimonioCmsEntry?.data.title ?? 'Il matrimonio';
const cmsOriginalTitle = matrimonioCmsEntry?.data.originalTitle ?? 'Ślub';
const cmsYear = matrimonioCmsEntry?.data.year ?? '1948';
const cmsAuthor = matrimonioCmsEntry?.data.author ?? '{cmsAuthor}';


---

<Layout
  title="Il matrimonio | Tan Tan Teatro"
  description="Witold Gombrowicz, 1948"
  locale="it"
  image="/img/matrimonio02.jpg"
>
  <article class="show-page">

    <section class="show-hero">
      <div class="show-hero-copy">
        <h1>{cmsTitle}</h1>
        <p class="show-original"><em>{cmsOriginalTitle}</em>, {cmsYear}</p>
        <p class="show-author">Witold Gombrowicz</p>
      </div>

      <figure class="show-hero-image">
        <img src="/img/matrimonio01.jpg" alt="Il Matrimonio" />
      </figure>
    </section>

    <section class="show-synopsis-standalone">
  <div class="show-synopsis-copy">
      <p>L’«Io è un altro» scrive Rimbaud; «l'io è il muso che mi hanno affibbiato gli altri», pensa Witold Gombrowicz (1904-1969), secondo l’interpretazione critica offerta da Jan Kott (1971). Nella seconda opera teatrale dell’autore polacco, il cerimoniale umano, e in particolare il rituale del matrimonio, sono al centro dell’attenzione.</p>

        <p>Concepita come farsa tragica, la pièce interroga i modi in cui l’impotenza dell’uomo, cui resta solo la possibilità dello scontro e di gesti simbolici e deformanti, assume le manifestazioni più grottesche. In una dimensione sospesa fra sogno e veglia, la vicenda, ambientata da Gombrowicz nella cupa notte della Seconda guerra mondiale, è riportata al nostro tempo contemporaneo, nel quale indifferenza, senso di impotenza e volgarità convivono nuovamente nel vivere quotidiano.</p>
    </div>
</section>

    <figure class="show-stage-band">
      <img src={bandImage} alt="Il Matrimonio" loading="lazy" />
    </figure>

<section class="show-credits-horizontal">
  <h2>Scheda artistica</h2>

      <div class="show-credits-grid">
        <div class="show-credit show-credit-cast">
          <strong>Interpreti</strong>
          <p>Gabriela Checchia, Pablo Comune, Siyuan Chen, Viola Cicoria, Eleonora Congiu, Olivia Del Sante, Arturo Gerace, Stefano Martelli, Anita Masi, Camilla Rizzo, Aurora Matilde Viola Sempio, Francesca Tomalino, Giulia Tonello, Gabriele Vaschetti, Giorgio Zaccarelli.</p>
        </div>

        <div class="show-credit-column">
          <div class="show-credit">
            <strong>Musiche</strong>
            <p>Andrea D'Oria</p>
          </div>

          <div class="show-credit">
            <strong>Coreografie</strong>
            <p>Francesca Tomalino</p>
          </div>
        </div>

        <div class="show-credit-column">
          <div class="show-credit">
            <strong>Disegno luci</strong>
            <p>Marco Usmigli</p>
          </div>

          <div class="show-credit">
            <strong>Adattamento drammaturgico e regia</strong>
            <p>Leonardo Mancini</p>
          </div>

          <div class="show-credit">
            <em>Durata</em>
            <p>{cmsDuration}.</p>
          </div>
        </div>
      </div>
</section>

<section class="show-trailer">
      <div class="show-trailer-copy">
        <span>TRAILER</span>
        <h2>Il matrimonio</h2>
      </div>

      <div class="show-video">
        <iframe
          src="https://www.youtube.com/embed/K0mLRFFcIG4?si=9ctbi23Yk4KGJ7Wt"
          title="Trailer Il matrimonio"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen>
        </iframe>
      </div>
    </section>

    

    

    <section class="show-history">
      <div class="show-performances">
        <h2>Precedenti rappresentazioni</h2>

      <div class="show-performance-list">
<div class="show-performance">
        <strong>26/09/2026:</strong>
        <span>Il Matrimonio (II atto) — UNight 2026 – Notte europea delle ricercatrici e dei ricercatori, Castello del Valentino, Torino</span>
      </div>

      <div class="show-performance">
        <strong>05-06/09/2026:</strong>
        <span>Il Matrimonio — <a href="https://www.festivalmirabilia.it/" target="_blank" rel="noopener noreferrer">Festival Mirabilia</a>, Cuneo</span>
      </div>



        <div class="show-performance">
          <strong>02/08/2026:</strong>
          <span>Fuma che 'nduma, Centro Ippico Equi Maresco, Savigliano</span>
        </div>

        <div class="show-performance">
          <strong>03/07/2026:</strong>
          <span>Spazio Kairós, Torino</span>
        </div>

        <div class="show-performance">
          <strong>27/06/2026:</strong>
          <span>Villa Martini, Cavagnolo (Torino)</span>
        </div>

        <div class="show-performance">
          <strong>28/05/2026,</strong>
          <span><a href="https://iiclione.esteri.it/it/gli_eventi/calendario/il-matrimonio-le-mariage-spettacolo-nellambito-del-festival-meraki-5/" target="_blank">Festival de théâtre universitaire "Meraki"</a>, MJC Monplaisir - Le Karbone, Lione</span>
        </div>

        <div class="show-performance">
          <strong>28/02/2026:</strong>
          <span>Teatro Giacosa, Ivrea (anteprima: 20 minuti)</span>
        </div>
      </div>

</div>

      <div class="show-press">
        <h2>Rassegna stampa</h2>

        <div class="show-press-grid">
          <article>
            <p>Hugo Genève, <a href="/doc/2026.05.28 - ENTRACTE 3.pdf" target="_blank">Il matrimonio</a>, "L'Entracte", n. 3, 28 maggio 2026, p. 2</p>
            <a
          class="show-press-arrow"
          href="/doc/2026.05.28 - ENTRACTE 3.pdf"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Apri il contenuto della rassegna stampa"
        >→</a>
          </article>

          <article>
            <p>Intervista a Francesca Tomalino e a Olivia Del Sante, <a href="https://www.instagram.com/reels/DY7nt8KzigJ/" target="_blank">L'Entracte | Le Podcast</a>, 28/05/2026</p>
            <a
          class="show-press-arrow"
          href="https://www.instagram.com/reels/DY7nt8KzigJ/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Apri il contenuto della rassegna stampa"
        >→</a>
          </article>

          <article>
            <p>Claudio Rocco, Intervista a Leonardo Mancini, <a href="https://podcast.ausha.co/radio-fuori-campo/il-matrimonio" target="_blank">"Radio Fuori Campo"</a>, 11/06/2026</p>
            <a
          class="show-press-arrow"
          href="https://podcast.ausha.co/radio-fuori-campo/il-matrimonio"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Apri il contenuto della rassegna stampa"
        >→</a>
          </article>
        </div>
      </div>
    </section>



    <section class="show-info">
      <div class="show-accessibility">
        <h2>Accessibilità</h2>

        <p>Per l'accessibilità dello spettacolo, sono disponibili audiodescrizioni in italiano e sopratitoli in italiano, in inglese e in francese, tramite un'apposita piattaforma per l'accessibilità (<a href="https://www.stentor.live/it/" target="_blank">Sténtor</a>), che è stata sviluppata nell'ambito del progetto di <em>public engagement</em> dell'Università degli Studi di Torino "<a href="https://www.unito.it/territorio-e-societa/condivisione-e-partecipazione/progetti-di-public-engagement-di-ateneo-45" target="_blank">Etica. Esplorazioni Teatrali e Innovazione per una Cultura Accessibile</a>". Sono inoltre state realizzate audiodescrizioni. Per ulteriori informazioni: <a href="mailto:accessibilita@tantanteatro.it">accessibilita@tantanteatro.it</a></p>
      </div>

      <div class="show-materials">
        <h2>Materiali</h2>

        <div class="show-material-links">
          <a href="/doc/Tan Tan Teatro, Il Matrimonio – Scheda dello spettacolo.pdf" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 3.5h6.5L18 8v12.5H7V3.5Z"/>
              <path d="M13.5 3.5V8H18"/>
              <path d="M9.5 12h6M9.5 15h6M9.5 18h4"/>
            </svg>
            <span><strong>Libretto di sala</strong><small>PDF</small></span>
          </a>

          <a href="/doc/Tan Tan Teatro, Il Matrimonio – Rassegna stampa.pdf" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 3.5h6.5L18 8v12.5H7V3.5Z"/>
              <path d="M13.5 3.5V8H18"/>
              <path d="M9.5 12h6M9.5 15h6M9.5 18h4"/>
            </svg>
            <span><strong>Dossier stampa</strong><small>PDF</small></span>
          </a>

          <a href="/doc/Tan Tan Teatro, Il Matrimonio – Tech Rider.pdf" target="_blank">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 3.5h6.5L18 8v12.5H7V3.5Z"/>
              <path d="M13.5 3.5V8H18"/>
              <path d="M9.5 12h6M9.5 15h6M9.5 18h4"/>
            </svg>
            <span><strong>Scheda tecnica</strong><small>PDF</small></span>
          </a>
        </div>
      </div>
    </section>

    </article>

<section class="show-gallery-horizontal">
  <AutoGallery
    slug="matrimonio"
    title="Galleria fotografica"
    group="matrimonio"
    variant="horizontal-full"
  />
</section>


{relatedAlbumCover && (
  <section class="show-related-albums" aria-labelledby="related-photo-albums-title">
    <div class="show-related-albums__head">
      <p class="show-related-albums__eyebrow">Archivio fotografico</p>
      <h3 id="related-photo-albums-title">Altre raccolte</h3>
    </div>

    <div class="show-related-albums__list">
      <a
        class="show-related-album"
        href={relatedAlbumCover.src}
        data-fancybox="matrimonio-studiumlab-prove-2026-05-22"
        data-caption={relatedAlbumCover.alt}
      >
        <div class="show-related-album__image">
          <img
            src={relatedAlbumCover.src}
            alt="Il matrimonio — prove StudiumLab, 22 maggio 2026"
            loading="lazy"
          />
        </div>

        <div class="show-related-album__copy">
          <p class="show-related-album__meta">Torino · 22 maggio 2026</p>
          <h3>StudiumLab — prove</h3>
          <span class="show-related-album__action">Apri album →</span>
        </div>
      </a>

      {relatedAlbumImages
        .filter((image) => image.src !== relatedAlbumCover.src)
        .map((image) => (
          <a
            href={image.src}
            data-fancybox="matrimonio-studiumlab-prove-2026-05-22"
            data-caption={image.alt}
            class="show-related-album__hidden"
            tabindex="-1"
            aria-hidden="true"
          ></a>
        ))}
    </div>
  </section>
)}

<script>
  import { Fancybox } from '@fancyapps/ui';

  function initMarriageRelatedAlbums() {
    document.querySelectorAll('.show-related-albums__list').forEach((root) => {
      Fancybox.unbind(root);

      Fancybox.bind(root, 'a[data-fancybox]', {
        Hash: false,
        Thumbs: {
          autoStart: true,
        },
        Toolbar: {
          display: {
            left: ['infobar'],
            middle: [],
            right: ['zoom', 'slideshow', 'fullscreen', 'thumbs', 'close'],
          },
        },
      });
    });
  }

  initMarriageRelatedAlbums();
  document.addEventListener('astro:page-load', initMarriageRelatedAlbums);
</script>

<div class="show-page show-after-gallery">
<nav class="show-next" aria-label="Navigazione spettacoli">
      <a href="/spettacoli">← Spettacoli</a>
      <a href="/spettacoli/macbett">Macbett →</a>
    </nav>
</div>

<style>
  .show-related-albums {
    width: min(1320px, calc(100vw - 64px));
    margin: clamp(3.5rem, 7vw, 7rem) auto clamp(4rem, 7vw, 7rem);
  }

  .show-related-albums__head {
    display: grid;
    grid-template-columns: minmax(180px, .35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    padding-bottom: clamp(1.2rem, 2vw, 1.8rem);
    border-bottom: 1px solid rgba(18, 18, 18, .18);
  }

  .show-related-albums__eyebrow {
    margin: 0;
    font-size: .76rem;
    line-height: 1.3;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .58;
  }

  .show-related-albums__head h3 {
    margin: 0;
    line-height: 1.2;
    letter-spacing: normal;
    font-weight: 400;
  }

  .show-related-albums__list {
    margin-top: clamp(1.5rem, 3vw, 2.8rem);
  }

  .show-related-album {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr);
    min-height: clamp(340px, 38vw, 540px);
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid rgba(18, 18, 18, .18);
  }

  .show-related-album__image {
    min-width: 0;
    overflow: hidden;
    background: #111;
  }

  .show-related-album__image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(340px, 38vw, 540px);
    object-fit: cover;
    transition: transform .6s ease;
  }

  .show-related-album:hover .show-related-album__image img {
    transform: scale(1.015);
  }

  .show-related-album__copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.6rem, 3.2vw, 3.2rem);
    border-top: 1px solid rgba(18, 18, 18, .18);
  }

  .show-related-album__meta {
    margin: 0 0 .9rem;
    font-size: .78rem;
    line-height: 1.3;
    letter-spacing: .08em;
    text-transform: uppercase;
    opacity: .58;
  }

  .show-related-album__copy h3 {
    margin: 0;
    font-size: clamp(2rem, 3vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -.02em;
    font-weight: 400;
  }

  .show-related-album__action {
    margin-top: clamp(2rem, 5vw, 5rem);
    font-size: .88rem;
    letter-spacing: .04em;
  }

  .show-related-album__hidden {
    display: none !important;
  }

  @media (max-width: 800px) {
    .show-related-albums {
      width: calc(100vw - 32px);
      margin-top: 4rem;
    }

    .show-related-albums__head,
    .show-related-album {
      grid-template-columns: 1fr;
    }

    .show-related-albums__head {
      gap: .7rem;
    }

    .show-related-album {
      min-height: 0;
    }

    .show-related-album__image img {
      min-height: 0;
      aspect-ratio: 4 / 3;
    }

    .show-related-album__copy {
      min-height: 230px;
    }

    .show-related-album__action {
      margin-top: 3rem;
    }
  }
</style>

</Layout>
