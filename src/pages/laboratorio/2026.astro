---
import Layout from "../../layouts/Layout.astro";
const heroImage = "/img/lab01.jpeg";
---

<Layout title="Laboratorio 2026 | Tan Tan Teatro" description="Laboratorio 2026 di Tan Tan Teatro: training fisico e movimento, dal 2 ottobre al 16 dicembre 2026 a StudiumLab, Palazzo Nuovo, Torino.">
  <main id="tt-lab-2026">
    <section class="tt-lab-hero" aria-labelledby="tt-lab-2026-title">
      <img class="tt-lab-hero-image" src={heroImage} alt="Un momento del laboratorio di training Tan Tan Teatro" loading="eager" fetchpriority="high" decoding="async" />
      <div class="tt-lab-hero-shade" aria-hidden="true"></div>
      <div class="tt-lab-width tt-lab-hero-copy">
        <p class="tt-lab-kicker">LABORATORIO · EDIZIONE 2026</p>
        <h1 id="tt-lab-2026-title">Training fisico e movimento<br /><span>Corpo, movimento, voce</span></h1>
      </div>
    </section>

    <div class="tt-lab-width tt-lab-content">
      <section class="tt-lab-overview" aria-labelledby="tt-lab-2026-overview-title">
        <div>
          <p class="tt-lab-kicker">OTTOBRE–DICEMBRE 2026</p>
          <h2 id="tt-lab-2026-overview-title">Un percorso per allenare presenza, ascolto e relazione.</h2>
          <p>Un laboratorio dedicato all’allenamento dell’attore e all’esplorazione del movimento: attivazione corporea, esercizi individuali e di gruppo, improvvisazione e floorwork, con attenzione alla presenza scenica, all’ascolto e alla relazione con gli altri.</p>
        </div>
        <aside class="tt-lab-card" aria-label="Informazioni pratiche">
          <p class="tt-lab-status">Iscrizioni chiuse</p>
          <dl>
            <div><dt>Quando</dt><dd>2 ottobre – 16 dicembre 2026</dd></div>
            <div><dt>Dove</dt><dd>StudiumLab · Palazzo Nuovo<br />Università degli Studi di Torino</dd></div>
            <div><dt>Conduzione</dt><dd>Leonardo Mancini e Francesca Tomalino</dd></div>
          </dl>
        </aside>
      </section>

      <section class="tt-lab-calendar" aria-labelledby="tt-lab-calendar-title">
        <div class="tt-lab-calendar-head">
          <p class="tt-lab-kicker">CALENDARIO DEGLI INCONTRI</p>
          <h2 id="tt-lab-calendar-title">Ottobre–dicembre 2026</h2>
          <p>Gli incontri si svolgono a StudiumLab, Palazzo Nuovo, Università degli Studi di Torino.</p>
        </div>
        <div class="tt-lab-calendar-grid">
          <article class="tt-lab-calendar-item tt-lab-calendar-item-featured"><p class="tt-lab-calendar-date"><time datetime="2026-10-02">Venerdì 2 ottobre 2026</time></p><p class="tt-lab-calendar-time">10:00–12:00</p><p class="tt-lab-calendar-note">Primo incontro</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-10-07">Mercoledì 7 ottobre 2026</time></p><p class="tt-lab-calendar-time">17:30–20:00</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-10-14">Mercoledì 14 ottobre 2026</time></p><p class="tt-lab-calendar-time">17:30–20:00</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-10-21">Mercoledì 21 ottobre 2026</time></p><p class="tt-lab-calendar-time">17:30–20:00</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-10-28">Mercoledì 28 ottobre 2026</time></p><p class="tt-lab-calendar-time">17:30–20:00</p></article>
          <article class="tt-lab-calendar-item tt-lab-calendar-item-pause"><p class="tt-lab-calendar-date">Prima settimana di novembre</p><p class="tt-lab-calendar-time">Pausa</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-11-11">Mercoledì 11 novembre 2026</time></p><p class="tt-lab-calendar-time">17:00–20:00</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-11-18">Mercoledì 18 novembre 2026</time></p><p class="tt-lab-calendar-time">10:00–12:00</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-12-02">Mercoledì 2 dicembre 2026</time></p><p class="tt-lab-calendar-time">17:00–20:00</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-12-09">Mercoledì 9 dicembre 2026</time></p><p class="tt-lab-calendar-time">17:00–20:00</p></article>
          <article class="tt-lab-calendar-item"><p class="tt-lab-calendar-date"><time datetime="2026-12-16">Mercoledì 16 dicembre 2026</time></p><p class="tt-lab-calendar-time">17:00–20:00</p></article>
        </div>
      </section>

      <section class="tt-lab-footer-note">
        <a href="/laboratorio">← Torna indietro</a>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  #tt-lab-2026 { --tt-paper:#faf9f6; --tt-panel:#f2f0eb; --tt-ink:#20201e; --tt-rule:#dedbd5; background:var(--tt-paper); color:var(--tt-ink); font-size:18px; line-height:1.6; }
  #tt-lab-2026 *, #tt-lab-2026 *::before, #tt-lab-2026 *::after { box-sizing:border-box; }
  #tt-lab-2026 .tt-lab-width { width:min(1280px, calc(100% - 64px)); margin-inline:auto; }
  #tt-lab-2026 .tt-lab-hero { position:relative; isolation:isolate; display:flex; align-items:center; min-height:clamp(320px,25vw,440px); padding:56px 0; overflow:hidden; background:#30302e; color:#fff; }
  #tt-lab-2026 .tt-lab-hero-image { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:50% 66%; filter:grayscale(1); }
  #tt-lab-2026 .tt-lab-hero-shade { position:absolute; inset:0; background:linear-gradient(90deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.53) 42%,rgba(0,0,0,.10) 100%); }
  #tt-lab-2026 .tt-lab-hero-copy { position:relative; z-index:1; }
  #tt-lab-2026 .tt-lab-kicker { margin:0 0 14px; font-family:system-ui,-apple-system,"Segoe UI",sans-serif; font-size:12px; font-weight:600; line-height:1.5; letter-spacing:2.2px; text-transform:uppercase; }
  #tt-lab-2026 h1 { max-width:960px; margin:0; color:#fff; font-size:clamp(36px,3.35vw,60px); font-weight:600; line-height:1.1; letter-spacing:-.7px; }
  #tt-lab-2026 .tt-lab-content { padding:52px 0 72px; }
  #tt-lab-2026 .tt-lab-overview { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(320px,.75fr); gap:64px; align-items:start; margin-bottom:48px; }
  #tt-lab-2026 h2 { margin:0 0 20px; font-size:clamp(29px,2.25vw,37px); font-weight:600; line-height:1.14; letter-spacing:-.4px; }
  #tt-lab-2026 .tt-lab-overview > div > p:last-child { margin:0; font-size:18px; line-height:1.65; }
  #tt-lab-2026 .tt-lab-card { padding:30px 32px; background:var(--tt-panel); border:1px solid var(--tt-rule); border-radius:6px; }
  #tt-lab-2026 .tt-lab-status { margin:0 0 22px; padding-left:16px; border-left:2px solid currentColor; font-weight:600; }
  #tt-lab-2026 dl, #tt-lab-2026 dl div, #tt-lab-2026 dt, #tt-lab-2026 dd { margin:0; }
  #tt-lab-2026 dl div + div { margin-top:18px; padding-top:18px; border-top:1px solid var(--tt-rule); }
  #tt-lab-2026 dt { margin-bottom:3px; font-family:system-ui,-apple-system,"Segoe UI",sans-serif; font-size:11px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase; }
  #tt-lab-2026 dd { font-size:16px; line-height:1.5; }
  #tt-lab-2026 .tt-lab-calendar { padding:36px 0 32px; border-top:1px solid var(--tt-rule); }
  #tt-lab-2026 .tt-lab-calendar-head { max-width:760px; margin-bottom:26px; }
  #tt-lab-2026 .tt-lab-calendar-head h2 { margin-bottom:12px; }
  #tt-lab-2026 .tt-lab-calendar-head > p:last-child { margin:0; font-size:17px; }
  #tt-lab-2026 .tt-lab-calendar-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--tt-rule); }
  #tt-lab-2026 .tt-lab-calendar-item { min-width:0; padding:20px 22px 20px 0; border-bottom:1px solid var(--tt-rule); }
  #tt-lab-2026 .tt-lab-calendar-item:nth-child(even) { padding-left:22px; border-left:1px solid var(--tt-rule); }
  #tt-lab-2026 .tt-lab-calendar-date, #tt-lab-2026 .tt-lab-calendar-time, #tt-lab-2026 .tt-lab-calendar-note { margin:0; }
  #tt-lab-2026 .tt-lab-calendar-date { font-size:17px; font-weight:600; line-height:1.45; }
  #tt-lab-2026 .tt-lab-calendar-time { margin-top:4px; font-size:16px; line-height:1.45; }
  #tt-lab-2026 .tt-lab-calendar-note { margin-top:8px; font-family:system-ui,-apple-system,"Segoe UI",sans-serif; font-size:11px; font-weight:600; letter-spacing:1.4px; text-transform:uppercase; }
  #tt-lab-2026 .tt-lab-calendar-item-featured { padding-left:18px; border-left:3px solid currentColor; }
  #tt-lab-2026 .tt-lab-calendar-item-pause { opacity:.72; }
  #tt-lab-2026 .tt-lab-footer-note { margin-top:28px; padding-top:28px; border-top:1px solid var(--tt-rule); }
  #tt-lab-2026 .tt-lab-footer-note p { margin:0 0 14px; }
  #tt-lab-2026 .tt-lab-footer-note a { color:inherit; text-underline-offset:4px; }
  @media (max-width:820px) {
    #tt-lab-2026 .tt-lab-width { width:calc(100% - 40px); }
    #tt-lab-2026 .tt-lab-hero { min-height:320px; padding-block:48px; }
    #tt-lab-2026 .tt-lab-hero-shade { background:rgba(0,0,0,.56); }
    #tt-lab-2026 .tt-lab-overview { grid-template-columns:1fr; gap:32px; }
    #tt-lab-2026 .tt-lab-calendar-grid { grid-template-columns:1fr; }
    #tt-lab-2026 .tt-lab-calendar-item, #tt-lab-2026 .tt-lab-calendar-item:nth-child(even) { padding:18px 0; border-left:0; }
    #tt-lab-2026 .tt-lab-calendar-item-featured { padding-left:16px; border-left:3px solid currentColor; }
  }
</style>
