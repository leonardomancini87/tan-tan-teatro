---
// Il quaderno del laboratorio: pagina pubblica raggiungibile solo con il link.
// URL: /lab/<codice>  (vercel.json riscrive /lab/:code su questa pagina)
// Legge e scrive solo tramite le funzioni Supabase workshop_notebook_get / workshop_notebook_add.
import Layout from '../../layouts/Layout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
---

<Layout title="Il quaderno | Tan Tan Teatro" description="Il quaderno condiviso del laboratorio." noindex>
  <div
    class="nb"
    data-notebook-page
    data-url={supabaseUrl}
    data-key={supabaseKey}
  >
    <p class="nb-status" data-loading><span></span><span></span><span></span><b class="nb-sr">Apro il quaderno…</b></p>

    <div class="nb-missing" data-missing hidden>
      <p class="nb-kicker">Quaderno del laboratorio</p>
      <h1>Quaderno non trovato</h1>
      <p>Il link potrebbe essere scaduto o incompleto. Chiedi a chi conduce il laboratorio quello aggiornato.</p>
    </div>

    <div class="nb-content" data-content hidden>
      <header class="nb-head">
        <p class="nb-kicker">Quaderno del laboratorio</p>
        <h1 data-title></h1>
        <p class="nb-period" data-period></p>
        <p class="nb-invite" data-invitation></p>
        <p class="nb-count" data-count></p>
        <p class="nb-note">Questa pagina è riservata ai partecipanti del laboratorio ed è visibile solo a chi ha ricevuto il link.</p>
      </header>

      <section class="nb-compose" data-compose aria-label="Lascia una traccia">
        <button type="button" class="nb-open" data-open-form>
          <span>Scrivi una traccia…</span>
          <span class="nb-open-icons" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-9 9"/></svg>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
          </span>
        </button>

        <form class="nb-form" data-form novalidate hidden>
          <label for="nb-body" class="nb-sr">La tua traccia</label>
          <textarea id="nb-body" name="body" rows="5" maxlength="4000" placeholder="Testo"></textarea>

          <div class="nb-attach" data-link-row hidden>
            <label for="nb-link" class="nb-sr">Link</label>
            <input id="nb-link" name="link" type="url" inputmode="url" placeholder="https://…" maxlength="2000" />
          </div>

          <div class="nb-preview" data-image-preview hidden>
            <img alt="" data-image-thumb />
            <button type="button" class="nb-plain" data-image-remove>Togli l'immagine</button>
          </div>

          <div class="nb-tools">
            <label class="nb-tool">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-9 9"/></svg>
              Immagine
              <input type="file" accept="image/*" data-image-input class="nb-sr" />
            </label>
            <button type="button" class="nb-tool" data-link-toggle aria-expanded="false">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/></svg>
              Link
            </button>
          </div>

          <div class="nb-sign">
            <label for="nb-name" class="nb-sr">Nome</label>
            <input id="nb-name" name="name" autocomplete="given-name" maxlength="60" placeholder="Il tuo nome" required />
            <button type="submit" class="nb-submit" data-submit>Lascia una traccia</button>
          </div>

          <p class="nb-message" data-message role="status" aria-live="polite"></p>
        </form>
      </section>

      <p class="nb-closed" data-closed hidden>
        Il quaderno è chiuso: puoi ancora sfogliarlo, ma non aggiungere nuove tracce.
      </p>

      <div class="nb-entries" data-entries></div>
    </div>

    <button type="button" class="nb-fab" data-fab hidden>
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
      Scrivi
    </button>

    <dialog class="nb-lightbox" data-lightbox aria-label="Immagine">
      <figure>
        <img alt="" data-lightbox-img />
        <figcaption data-lightbox-caption></figcaption>
      </figure>
      <button type="button" class="nb-close" data-lightbox-close aria-label="Chiudi">
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </dialog>
  </div>
</Layout>

<style is:global>
  /* Il sito usa html { font-size: 62.5% }: qui le misure sono in px. */
  body:has(.nb) { background: #f7f6f2; }
  [data-theme='dark'] body:has(.nb) { background: #141517; }

  .nb {
    --nb-ink: #16171a;
    --nb-soft: #5e5d59;
    --nb-faint: #8a877f;
    --nb-line: #e2e0da;
    --nb-field: #d8d5cd;
    --nb-paper: #efeeea;
    --nb-card: #fbfaf7;
    --nb-ground: #f7f6f2;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(40px, 9vw, 96px) 20px 40px;
    box-sizing: border-box;
    color: var(--nb-ink);
    font-family: var(--font-sans-serif);
    font-size: 16px;
  }
  [data-theme='dark'] .nb {
    --nb-ink: #ecebe6;
    --nb-soft: #b5b2aa;
    --nb-faint: #8d8a83;
    --nb-line: #2c2d31;
    --nb-field: #3f4045;
    --nb-paper: #1c1d20;
    --nb-card: #1a1b1e;
    --nb-ground: #141517;
  }
  .nb *, .nb *::before, .nb *::after { box-sizing: border-box; }
  .nb [hidden] { display: none !important; }
  .nb-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* Caricamento: tre punti che respirano */
  .nb-status { display: flex; gap: 8px; justify-content: center; padding: 120px 0; margin: 0; }
  .nb-status span {
    width: 6px; height: 6px; border-radius: 50%; background: var(--nb-faint);
    animation: nb-breathe 1.4s ease-in-out infinite;
  }
  .nb-status span:nth-child(2) { animation-delay: .2s; }
  .nb-status span:nth-child(3) { animation-delay: .4s; }
  .nb-status.nb-status-text { display: block; text-align: center; color: var(--nb-soft); font-size: 17px; }
  @keyframes nb-breathe { 0%, 100% { opacity: .25; } 50% { opacity: 1; } }

  /* Intestazione */
  .nb-head { max-width: 640px; }
  .nb-kicker {
    margin: 0 0 28px;
    font-size: 12px; letter-spacing: .26em; text-transform: uppercase; color: var(--nb-soft);
  }
  .nb h1 {
    margin: 0;
    font-family: var(--font-serif); font-weight: 400;
    font-size: clamp(46px, 10vw, 84px); line-height: 1; letter-spacing: -.01em;
    text-wrap: balance;
  }
  .nb-period {
    margin: 18px 0 0;
    font-family: var(--font-serif); font-style: italic; font-size: 21px; color: var(--nb-soft);
  }
  .nb-period:empty { display: none; }
  .nb-invite {
    margin: 40px 0 0; max-width: 28em;
    font-family: var(--font-serif); font-size: clamp(22px, 3.6vw, 27px); line-height: 1.45;
    text-wrap: pretty;
  }
  .nb-invite:empty { display: none; }
  .nb-count {
    display: flex; align-items: center; gap: 14px;
    margin: 40px 0 0; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: var(--nb-soft);
  }
  .nb-count::before { content: ''; width: 40px; height: 1px; background: var(--nb-field); }
  .nb-count:empty { display: none; }
  .nb-note { margin: 14px 0 0; max-width: 34em; font-size: 14px; line-height: 1.5; color: var(--nb-soft); }
  .nb-count:empty + .nb-note { margin-top: 40px; }


  /* Scrivere */
  .nb-compose { margin: 56px 0 72px; scroll-margin-top: 24px; }
  .nb-content > :last-child { margin-bottom: 0; }
  .nb .nb-open, .nb .nb-tool, .nb .nb-plain, .nb .nb-submit, .nb .nb-fab, .nb .nb-close {
    height: auto; line-height: 1.2; box-shadow: none; text-transform: none; letter-spacing: normal;
    font-family: var(--font-sans-serif); cursor: pointer;
  }
  .nb .nb-open {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    width: 100%; min-height: 72px; padding: 0 24px;
    background: var(--nb-card); border: 1px solid var(--nb-line); border-radius: 4px;
    color: var(--nb-faint) !important; text-align: left;
    font-family: var(--font-serif); font-size: 22px; font-style: italic;
    transition: border-color .2s ease;
  }
  .nb .nb-open:hover { border-color: var(--nb-field); }
  .nb-open-icons { display: flex; gap: 14px; color: var(--nb-faint); }

  .nb-form {
    display: flex; flex-direction: column; gap: 18px;
    padding: clamp(20px, 4vw, 28px);
    background: var(--nb-card); border: 1px solid var(--nb-line); border-radius: 4px;
  }
  .nb input:not([type='file']), .nb textarea {
    min-width: 0; margin: 0;
    border: 1px solid var(--nb-field); border-radius: 3px;
    background: transparent; color: inherit; font: inherit;
  }
  .nb textarea {
    width: 100%; min-height: 160px; padding: 0; border: 0; resize: vertical;
    font-family: var(--font-serif); font-size: 22px; line-height: 1.55;
  }
  .nb textarea::placeholder { color: var(--nb-faint); font-style: italic; }
  .nb .nb-form input:focus, .nb .nb-form textarea:focus { outline: none; box-shadow: none; }
  .nb .nb-form input:focus { border-color: var(--nb-ink); }
  .nb .nb-form:focus-within { border-color: var(--nb-field); }
  .nb button:focus-visible, .nb a:focus-visible, .nb-tool:focus-within {
    outline: 2px solid var(--nb-ink); outline-offset: 3px;
  }
  .nb-attach input { width: 100%; height: 48px; padding: 0 14px; font-size: 17px; }

  .nb-preview { display: flex; align-items: center; gap: 16px; }
  .nb-preview img { width: 120px; height: 90px; object-fit: cover; border-radius: 2px; }

  .nb-tools { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 14px; border-top: 1px solid var(--nb-line); }
  .nb .nb-tool {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--nb-field); border-radius: 3px; background: transparent;
    color: var(--nb-ink) !important; font-size: 15px;
  }
  .nb-sign { display: flex; flex-wrap: wrap; gap: 10px; }
  .nb-sign input { flex: 1 1 200px; height: 48px; padding: 0 14px; font-size: 17px; }
  .nb .nb-submit {
    flex: 0 0 auto; min-height: 48px; padding: 0 24px; border: 0; border-radius: 3px;
    background: var(--nb-ink); color: var(--nb-ground) !important;
    font-size: 15px; font-weight: 500; letter-spacing: .02em;
  }
  .nb-submit[disabled] { opacity: .6; cursor: progress; }
  .nb .nb-plain {
    padding: 0; border: 0; background: none; color: var(--nb-soft) !important;
    font-size: 14px; text-decoration: underline;
  }
  .nb-message { margin: 0; font-size: 15px; color: var(--nb-soft); }
  .nb-message:empty { display: none; }

  .nb-closed {
    margin: 56px 0 72px; padding: 20px 0;
    border-top: 1px solid var(--nb-line); border-bottom: 1px solid var(--nb-line);
    color: var(--nb-soft); font-family: var(--font-serif); font-style: italic; font-size: 20px;
  }

  /* Le tracce */
  .nb-entries { display: flex; flex-direction: column; border-top: 1px solid var(--nb-ink); }
  .nb-entries:empty { display: none; }
  .nb-entry {
    display: grid; gap: 14px 40px;
    padding: 36px 0; border-bottom: 1px solid var(--nb-line);
  }
  .nb-entry:first-child { padding-top: 40px; }
  .nb-entry:last-child { border-bottom: 0; }
  .nb-margin { display: flex; align-items: baseline; gap: 10px; font-size: 14px; }
  .nb-margin strong { font-weight: 500; letter-spacing: .02em; }
  .nb-margin time { font-family: var(--font-serif); font-style: italic; font-size: 16px; color: var(--nb-soft); }
  .nb-body { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .nb-text {
    margin: 0; font-family: var(--font-serif); font-size: 22px; line-height: 1.6;
    white-space: pre-line; overflow-wrap: anywhere; text-wrap: pretty;
  }
  .nb-text.nb-short { font-size: clamp(26px, 4vw, 32px); line-height: 1.35; }

  .nb .nb-photo {
    display: block; width: 100%; padding: 0; margin: 0; border: 0; background: var(--nb-paper);
    border-radius: 2px; overflow: hidden; cursor: zoom-in;
  }
  .nb-photo img { display: block; width: 100%; height: auto; max-height: 80vh; object-fit: contain; transition: opacity .6s ease; }
  .nb-photo img[data-pending] { opacity: 0; }

  .nb-link {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 16px;
    padding: 16px 18px; border: 1px solid var(--nb-line); border-radius: 3px;
    background: var(--nb-card); color: inherit; text-decoration: none;
    transition: border-color .2s ease;
  }
  .nb-link:hover { border-color: var(--nb-field); }
  .nb-link small { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--nb-soft); }
  .nb-link span { grid-column: 1; font-family: var(--font-serif); font-size: 18px; overflow-wrap: anywhere; color: var(--nb-soft); }
  .nb-link svg { grid-column: 2; grid-row: 1 / span 2; color: var(--nb-faint); }

  @media (min-width: 760px) {
    .nb-entry { grid-template-columns: 150px minmax(0, 1fr); }
    .nb-margin { flex-direction: column; gap: 4px; padding-top: 8px; }
  }

  /* Comparsa gentile */
  .nb-reveal { animation: nb-in .7s ease both; }
  .nb-fresh { animation: nb-fresh 2.4s ease both; }
  @keyframes nb-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes nb-fresh { 0% { background: var(--nb-paper); } 100% { background: transparent; } }
  @media (prefers-reduced-motion: reduce) {
    .nb-reveal, .nb-fresh, .nb-status span { animation: none; }
    .nb-photo img { transition: none; }
  }

  /* Pulsante "Scrivi" sul telefono */
  .nb .nb-fab {
    position: fixed; right: 18px; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); z-index: 20;
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 20px;
    border: 0; border-radius: 999px; background: var(--nb-ink); color: var(--nb-ground) !important;
    font-size: 15px; font-weight: 500; box-shadow: 0 6px 24px rgba(0,0,0,.18);
  }
  @media (min-width: 760px) { .nb .nb-fab { display: none !important; } }

  /* Immagine ingrandita */
  .nb-lightbox {
    width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(18,18,20,.94); color: #ecebe6;
  }
  .nb-lightbox::backdrop { background: transparent; }
  .nb-lightbox figure {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px;
    width: 100%; height: 100%; margin: 0; padding: 56px 16px 24px;
  }
  .nb-lightbox img { max-width: 100%; max-height: calc(100% - 48px); object-fit: contain; }
  .nb-lightbox figcaption { font-size: 14px; letter-spacing: .04em; color: #b5b2aa; }
  .nb .nb-close {
    position: absolute; top: 12px; right: 12px;
    display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px;
    padding: 0; border: 0; border-radius: 50%; background: transparent; color: #ecebe6 !important;
  }


  .nb-missing { max-width: 640px; }
  .nb-missing p:last-child { margin-top: 24px; max-width: 30em; font-family: var(--font-serif); font-size: 22px; line-height: 1.5; }
</style>

<script>
  const MAX_SIDE = 1600;
  const NAME_KEY = 'tantan-quaderno-nome';
  const ERRORS: Record<string, string> = {
    quaderno_non_trovato: 'Questo quaderno non esiste più. Chiedi il link aggiornato.',
    quaderno_chiuso: 'Il quaderno è stato chiuso: non si possono più aggiungere tracce.',
    nome_mancante: 'Scrivi il tuo nome prima di lasciare una traccia.',
    immagine_non_valida: "Non è stato possibile allegare l'immagine.",
    immagine_non_trovata: "L'immagine non è arrivata: riprova a caricarla.",
    troppi_contributi: 'Hai lasciato molte tracce in poco tempo: riprova tra qualche minuto.',
  };

  type Entry = {
    id: string; author_name: string; body: string | null; link_url: string | null;
    image_path: string | null; created_at: string;
    session_id: string | null; session_title: string | null; session_starts: string | null;
  };

  function init() {
    const root = document.querySelector<HTMLElement>('[data-notebook-page]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    const url = root.dataset.url!;
    const key = root.dataset.key!;
    const pieces = location.pathname.split('/').filter(Boolean);
    const code = new URLSearchParams(location.search).get('c') || (pieces[0] === 'lab' ? pieces[1] || '' : '');

    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const loading = $<HTMLElement>('[data-loading]');
    const missing = $<HTMLElement>('[data-missing]');
    const content = $<HTMLElement>('[data-content]');
    const compose = $<HTMLElement>('[data-compose]');
    const openForm = $<HTMLButtonElement>('[data-open-form]');
    const form = $<HTMLFormElement>('[data-form]');
    const closed = $<HTMLElement>('[data-closed]');
    const entriesRoot = $<HTMLElement>('[data-entries]');
    const message = $<HTMLElement>('[data-message]');
    const submit = $<HTMLButtonElement>('[data-submit]');
    const nameInput = $<HTMLInputElement>('#nb-name');
    const bodyInput = $<HTMLTextAreaElement>('#nb-body');
    const linkRow = $<HTMLElement>('[data-link-row]');
    const linkInput = $<HTMLInputElement>('#nb-link');
    const linkToggle = $<HTMLButtonElement>('[data-link-toggle]');
    const imageInput = $<HTMLInputElement>('[data-image-input]');
    const imagePreview = $<HTMLElement>('[data-image-preview]');
    const imageThumb = $<HTMLImageElement>('[data-image-thumb]');
    const fab = $<HTMLButtonElement>('[data-fab]');
    const lightbox = $<HTMLDialogElement>('[data-lightbox]');
    const lightboxImg = $<HTMLImageElement>('[data-lightbox-img]');
    const lightboxCaption = $<HTMLElement>('[data-lightbox-caption]');

    let imageBlob: Blob | null = null;
    let entries: Entry[] = [];
    let isOpen = true;

    const headers = { apikey: key, Authorization: `Bearer ${key}` };

    async function rpc(name: string, body: object) {
      const res = await fetch(`${url}/rest/v1/rpc/${name}`, {
        method: 'POST',
        headers: { ...headers, 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });
      const text = await res.text();
      const data = text ? JSON.parse(text) : null;
      if (!res.ok) throw new Error(data?.message || 'errore');
      return data;
    }

    const publicImage = (path: string) =>
      `${url}/storage/v1/object/public/workshop-notebook-images/${path.split('/').map(encodeURIComponent).join('/')}`;

    // ---- date in italiano, con "oggi" e "ieri" ----
    const dayMonth = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long' });
    const dayMonthYear = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
    const shortDay = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'short' });
    const hourFmt = new Intl.DateTimeFormat('it-IT', { hour: '2-digit', minute: '2-digit' });

    const startOfDay = (d: Date) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
    function when(iso: string) {
      const d = new Date(iso);
      const diff = Math.round((startOfDay(new Date()) - startOfDay(d)) / 86400000);
      const day = diff === 0 ? 'oggi' : diff === 1 ? 'ieri' : shortDay.format(d);
      return `${day}, ${hourFmt.format(d)}`;
    }
    function period(from?: string | null, to?: string | null) {
      if (!from) return '';
      const a = new Date(`${from}T12:00:00`);
      if (!to) return `dal ${dayMonthYear.format(a)}`;
      const b = new Date(`${to}T12:00:00`);
      return a.getFullYear() === b.getFullYear()
        ? `${dayMonth.format(a)} — ${dayMonthYear.format(b)}`
        : `${dayMonthYear.format(a)} — ${dayMonthYear.format(b)}`;
    }

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
      const node = document.createElement(tag);
      if (cls) node.className = cls;
      if (text != null) node.textContent = text;
      return node;
    }
    function svg(markup: string) {
      const wrap = document.createElement('span');
      wrap.innerHTML = markup; // markup costante, mai dati degli utenti
      return wrap.firstElementChild!;
    }
    const ARROW = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"/></svg>';

    function safeLink(raw: string | null) {
      if (!raw) return null;
      try {
        const u = new URL(raw);
        return u.protocol === 'http:' || u.protocol === 'https:' ? u : null;
      } catch { return null; }
    }

    // ---- disegno delle tracce ----
    function renderEntry(e: Entry, fresh = false) {
      const art = el('article', 'nb-entry nb-reveal' + (fresh ? ' nb-fresh' : ''));
      art.id = `traccia-${e.id.slice(0, 8)}`;

      const margin = el('div', 'nb-margin');
      const time = el('time', '', when(e.created_at));
      time.dateTime = e.created_at;
      margin.append(el('strong', '', e.author_name), time);

      const body = el('div', 'nb-body');
      if (e.body) {
        const short = e.body.length <= 90 && !e.body.includes('\n');
        body.append(el('p', short ? 'nb-text nb-short' : 'nb-text', e.body));
      }
      if (e.image_path) {
        const button = el('button', 'nb-photo');
        button.type = 'button';
        button.setAttribute('aria-label', `Ingrandisci l'immagine di ${e.author_name}`);
        const img = el('img');
        img.dataset.pending = '';
        img.addEventListener('load', () => delete img.dataset.pending, { once: true });
        img.src = publicImage(e.image_path);
        img.alt = e.body ? '' : `Immagine lasciata da ${e.author_name}`;
        img.loading = 'lazy';
        img.decoding = 'async';
        button.append(img);
        button.addEventListener('click', () => openImage(img.src, `${e.author_name} · ${when(e.created_at)}`));
        body.append(button);
      }
      const link = safeLink(e.link_url);
      if (link) {
        const a = el('a', 'nb-link');
        a.href = link.href;
        a.target = '_blank';
        a.rel = 'noopener noreferrer nofollow';
        const path = decodeURIComponent(link.pathname + link.search).replace(/\/$/, '');
        a.append(
          el('small', '', link.hostname.replace(/^www\./, '')),
          el('span', '', path.length > 1 ? (path.length > 70 ? path.slice(0, 68) + '…' : path) : 'Apri il link'),
          svg(ARROW),
        );
        body.append(a);
      }
      art.append(margin, body);
      return art;
    }

    function render(freshId?: string) {
      entriesRoot.replaceChildren();
      const voices = new Set(entries.map((e) => e.author_name.trim().toLowerCase())).size;
      const n = entries.length;
      $('[data-count]').textContent = n
        ? `${n} ${n === 1 ? 'traccia' : 'tracce'} · ${voices} ${voices === 1 ? 'voce' : 'voci'}`
        : '';
      for (const e of entries) entriesRoot.append(renderEntry(e, e.id === freshId));
    }

    // ---- immagine ingrandita ----
    function openImage(src: string, caption: string) {
      lightboxImg.src = src;
      lightboxCaption.textContent = caption;
      if (typeof lightbox.showModal === 'function') lightbox.showModal();
      else window.open(src, '_blank', 'noopener');
    }
    $('[data-lightbox-close]').addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox || event.target === lightbox.querySelector('figure')) lightbox.close();
    });

    // ---- scrivere ----
    function showForm(focus = true) {
      openForm.hidden = true;
      form.hidden = false;
      if (focus) bodyInput.focus({ preventScroll: true });
    }
    openForm.addEventListener('click', () => showForm());

    fab.addEventListener('click', () => {
      compose.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
      showForm();
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([item]) => {
        fab.hidden = !isOpen || item.isIntersecting || item.boundingClientRect.top > 0;
      }).observe(compose);
    }

    async function shrink(file: File): Promise<Blob> {
      const bitmap = await createImageBitmap(file);
      const scale = Math.min(1, MAX_SIDE / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close?.();
      return new Promise((resolve, reject) =>
        canvas.toBlob((b) => (b ? resolve(b) : reject(new Error('immagine'))), 'image/jpeg', 0.85));
    }

    async function upload(blob: Blob) {
      const path = `${code}/${crypto.randomUUID()}.jpg`;
      const res = await fetch(`${url}/storage/v1/object/workshop-notebook-images/${path}`, {
        method: 'POST',
        headers: { ...headers, 'Content-Type': 'image/jpeg', 'x-upsert': 'false' },
        body: blob,
      });
      if (!res.ok) throw new Error('caricamento_immagine');
      return path;
    }

    function clearImage() {
      imageBlob = null;
      imageInput.value = '';
      if (imageThumb.src.startsWith('blob:')) URL.revokeObjectURL(imageThumb.src);
      imageThumb.removeAttribute('src');
      imagePreview.hidden = true;
    }

    imageInput.addEventListener('change', async () => {
      const file = imageInput.files?.[0];
      if (!file) return;
      message.textContent = 'Preparo l’immagine…';
      try {
        imageBlob = await shrink(file);
        imageThumb.src = URL.createObjectURL(imageBlob);
        imagePreview.hidden = false;
        message.textContent = '';
      } catch {
        clearImage();
        message.textContent = 'Questa immagine non si riesce ad aprire. Prova con una foto in formato JPG o PNG.';
      }
    });
    $('[data-image-remove]').addEventListener('click', clearImage);

    linkToggle.addEventListener('click', () => {
      linkRow.hidden = !linkRow.hidden;
      linkToggle.setAttribute('aria-expanded', String(!linkRow.hidden));
      if (!linkRow.hidden) linkInput.focus();
    });

    try { nameInput.value = localStorage.getItem(NAME_KEY) || ''; } catch {}

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = nameInput.value.trim();
      const body = bodyInput.value.trim();
      let link = linkInput.value.trim();
      if (link && !/^https?:\/\//i.test(link)) link = `https://${link}`;

      if (!body && !link && !imageBlob) { message.textContent = 'Scrivi qualcosa, oppure allega un’immagine o un link.'; bodyInput.focus(); return; }
      if (link && !safeLink(link)) { message.textContent = 'Il link non sembra valido.'; linkInput.focus(); return; }
      if (!name) { message.textContent = ERRORS.nome_mancante; nameInput.focus(); return; }

      submit.disabled = true;
      submit.textContent = 'Un momento…';
      message.textContent = '';
      try {
        const imagePath = imageBlob ? await upload(imageBlob) : null;
        const entry: Entry = await rpc('workshop_notebook_add', {
          p_code: code, p_author: name, p_body: body || null,
          p_link_url: link || null, p_image_path: imagePath,
        });
        try { localStorage.setItem(NAME_KEY, name); } catch {}
        entries = [entry, ...entries];
        render(entry.id);
        bodyInput.value = '';
        linkInput.value = '';
        linkRow.hidden = true;
        linkToggle.setAttribute('aria-expanded', 'false');
        clearImage();
        message.textContent = 'Grazie, la tua traccia è nel quaderno.';
        const fresh = root.querySelector(`#traccia-${entry.id.slice(0, 8)}`);
        fresh?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (error) {
        const reason = (error as Error).message;
        message.textContent = ERRORS[reason] || (reason === 'caricamento_immagine'
          ? "L'immagine non si è caricata. Riprova, oppure lascia la traccia senza immagine."
          : 'Qualcosa non ha funzionato. Riprova tra poco.');
        if (reason === 'quaderno_chiuso') { compose.hidden = true; closed.hidden = false; isOpen = false; fab.hidden = true; }
      } finally {
        submit.disabled = false;
        submit.textContent = 'Lascia una traccia';
      }
    });

    // ---- apertura ----
    (async () => {
      if (!code) { loading.hidden = true; missing.hidden = false; return; }
      try {
        const data = await rpc('workshop_notebook_get', { p_code: code });
        loading.hidden = true;
        if (!data) { missing.hidden = false; return; }
        $('[data-title]').textContent = data.title || 'Il quaderno';
        $('[data-period]').textContent = period(data.starts_on, data.ends_on);
        $('[data-invitation]').textContent = data.invitation || 'Condividi testo, immagini, link o altro.';
        document.title = `${data.title ? data.title + ' · ' : ''}Il quaderno | Tan Tan Teatro`;
        isOpen = !!data.is_open;
        compose.hidden = !isOpen;
        closed.hidden = isOpen;
        entries = data.entries || [];
        render();
        if (isOpen && !entries.length) showForm(false);
        content.hidden = false;
        if (location.hash) root.querySelector(location.hash)?.scrollIntoView();
      } catch {
        loading.replaceChildren(document.createTextNode('Non riesco ad aprire il quaderno in questo momento. Riprova tra poco.'));
        loading.classList.add('nb-status-text');
      }
    })();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
