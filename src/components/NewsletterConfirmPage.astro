---
/**
 * Pagina aperta dal link di conferma della newsletter
 * (/newsletter/conferma e /en/newsletter/confirm).
 */
import Layout from '../layouts/Layout.astro';
import NewsletterLinkAction from './NewsletterLinkAction.astro';

interface Props {
  locale?: 'it' | 'en';
}

const { locale = 'it' } = Astro.props;

const copy = {
  it: {
    title: 'Conferma l’iscrizione | Tan Tan Teatro',
    description: 'Conferma dell’iscrizione alla newsletter di Tan Tan Teatro.',
    kicker: 'Newsletter',
    heading: 'Conferma dell’iscrizione',
    back: 'Torna alla pagina Newsletter',
    backHref: '/newsletter',
  },
  en: {
    title: 'Confirm your subscription | Tan Tan Teatro',
    description: 'Confirmation of your subscription to the Tan Tan Teatro newsletter.',
    kicker: 'Newsletter',
    heading: 'Subscription confirmation',
    back: 'Back to the Newsletter page',
    backHref: '/en/newsletter',
  },
}[locale];
---

<Layout title={copy.title} description={copy.description} locale={locale} editorial={true}>
  <div class="tt-editorial">
    <section class="tt-nl-confirm-box" aria-labelledby="tt-nl-confirm-title">
      <p class="tt-kicker">{copy.kicker}</p>
      <h1 id="tt-nl-confirm-title">{copy.heading}</h1>
      <NewsletterLinkAction locale={locale} mode="confirm" />
      <a class="tt-nl-confirm-back" href={copy.backHref}>{copy.back}</a>
    </section>
  </div>
</Layout>

<style>
  .tt-nl-confirm-box {
    max-width: 640px;
    min-height: 46vh;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 104px) clamp(22px, 4vw, 48px);
  }
  .tt-nl-confirm-box .tt-kicker { color: var(--tt-muted); }
  .tt-nl-confirm-box h1 { margin-bottom: 18px; }
  .tt-nl-confirm-back {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-sans-serif);
    font-size: 14px;
    color: var(--tt-muted);
    text-decoration: underline;
  }
</style>
