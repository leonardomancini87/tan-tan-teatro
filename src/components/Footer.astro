---
interface Props {
  locale?: 'it' | 'en';
}

const { locale = 'it' } = Astro.props;

const isEn = locale === 'en';

const today = new Date().toLocaleDateString(
  isEn ? 'en-GB' : 'it-IT',
  { day: 'numeric', month: 'long', year: 'numeric' }
);

const homeHref = isEn ? '/en' : '/';

const cookieHref = isEn
  ? '/en/cookie-policy'
  : '/cookie-policy';
---

<footer class="site-footer">
  <div class="site-footer-content">
    <a href={homeHref}>
      Tan Tan Teatro
    </a>

    <p>
      {isEn
        ? `Turin, Italy | Last website update: ${today}`
        : `Torino, Italia | Ultimo aggiornamento del sito web: ${today}`}
      <br /><br />

      <a href={cookieHref}>Cookie Policy</a>
      {" | "}
      <a
        href="https://www.iubenda.com/privacy-policy/XXXXXXXX"
        target="_blank"
        rel="noopener noreferrer"
      >
        <a href="https://www.iubenda.com/privacy-policy/15384815" target="_blank">Privacy Policy
      </a>
    </p>
  </div>
</footer>