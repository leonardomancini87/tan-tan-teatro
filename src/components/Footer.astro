---
interface Props {
  locale?: 'it' | 'en';
}

const { locale = 'it' } = Astro.props;
const isEn = locale === 'en';

const today = new Date().toLocaleDateString(
  isEn ? 'en-GB' : 'it-IT',
  { day: 'numeric', month: 'long', year: 'numeric' }
);

const homeHref = isEn ? '/en' : '/';

const cookieHref = isEn
  ? '/en/cookie-policy'
  : '/cookie-policy';

const appPrivacyHref = '/privacy-app';

const iubendaPrivacyHref =
  'https://www.iubenda.com/privacy-policy/15384815';
---

<footer class="site-footer">
  <div class="site-footer-content">
    <a href={homeHref}>
      Tan Tan Teatro
    </a>

    <p>
      {isEn
        ? `Turin, Italy | Last website update: ${today}`
        : `Torino, Italia | Ultimo aggiornamento del sito web: ${today}`}

      <br /><br />

      <a href={cookieHref}>Cookie Policy</a>

      {" | "}

      <a
        href={iubendaPrivacyHref}
        target="_blank"
        rel="noopener noreferrer"
      >
        Privacy Policy
      </a>

      {" | "}

      <a href={appPrivacyHref}>
        {isEn ? 'App Privacy Policy' : 'Privacy dell’app'}
      </a>
    </p>
  </div>
</footer>
