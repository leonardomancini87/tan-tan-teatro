---
// Ricerca nel sito: lente nell'intestazione + pannello a tutto schermo.
// L'indice (/search/it.json, /search/en.json) è generato a fine build
// da src/integrations/site-search.mjs.
interface Props { locale: 'it' | 'en'; }
const { locale } = Astro.props;
const t = locale === 'en'
  ? {
      open: 'Search the site', label: 'Search the site', placeholder: 'Shows, venues, people, dates…', close: 'Close',
      hint: 'Try', suggestions: ['Macbett', 'The Marriage', 'surtitles', 'laboratory'],
      none: 'No results for “{q}”.', one: '1 page found.', many: '{n} pages found.', approx: 'No exact match: showing similar words.',
      loading: 'Loading…', error: 'Search is not available right now.', dev: 'The search index is created by the build (npm run build, then npm run preview).',
    }
  : {
      open: 'Cerca nel sito', label: 'Cerca nel sito', placeholder: 'Spettacoli, luoghi, persone, date…', close: 'Chiudi',
      hint: 'Prova con', suggestions: ['Macbett', 'Il matrimonio', 'sopratitoli', 'laboratorio'],
      none: 'Nessun risultato per “{q}”.', one: '1 pagina trovata.', many: '{n} pagine trovate.', approx: 'Nessuna corrispondenza esatta: ecco parole simili.',
      loading: 'Caricamento…', error: 'La ricerca non è disponibile in questo momento.', dev: 'L’indice di ricerca viene creato dalla build (npm run build, poi npm run preview).',
    };
---
<button class="tt-search-trigger" type="button" aria-label={t.open} title={t.open} aria-haspopup="dialog" aria-controls="tt-search-dialog" data-tt-search-open>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
</button>

<dialog id="tt-search-dialog" class="tt-search" aria-labelledby="tt-search-label" data-tt-search data-locale={locale}
  data-none={t.none} data-one={t.one} data-many={t.many} data-approx={t.approx}
  data-loading={t.loading} data-error={t.error} data-dev={t.dev}>
  <div class="tt-search-inner">
    <div class="tt-search-top">
      <label id="tt-search-label" class="tt-search-label" for="tt-search-input">{t.label}</label>
      <button class="tt-search-close" type="button" data-tt-search-close>{t.close} <span aria-hidden="true">×</span></button>
    </div>
    <input id="tt-search-input" class="tt-search-input" type="search" placeholder={t.placeholder} autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" aria-describedby="tt-search-status" />
    <p class="tt-search-suggestions" data-tt-search-suggestions>
      <span>{t.hint}</span>
      {t.suggestions.map((s) => <button type="button" data-tt-search-suggest={s}>{s}</button>)}
    </p>
    <p id="tt-search-status" class="tt-search-status" role="status" aria-live="polite"></p>
    <ol class="tt-search-results" data-tt-search-results></ol>
  </div>
</dialog>

<script>
  import { prepareIndex, search, highlight, excerpt, resultHref, escapeHTML } from '../lib/site-search.mjs';

  const indexes = new Map<string, Promise<any[]>>();
  function loadIndex(locale: string) {
    if (!indexes.has(locale)) {
      const p = fetch(`/search/${locale}.json`, { headers: { Accept: 'application/json' } })
        .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
        .then(prepareIndex);
      p.catch(() => indexes.delete(locale));
      indexes.set(locale, p);
    }
    return indexes.get(locale)!;
  }

  let cleanup: (() => void) | undefined;
  function init() {
    cleanup?.();
    const dialog = document.querySelector<HTMLDialogElement>('[data-tt-search]');
    const trigger = document.querySelector<HTMLButtonElement>('[data-tt-search-open]');
    if (!dialog || !trigger) return;
    const input = dialog.querySelector<HTMLInputElement>('.tt-search-input')!;
    const status = dialog.querySelector<HTMLElement>('.tt-search-status')!;
    const list = dialog.querySelector<HTMLOListElement>('[data-tt-search-results]')!;
    const suggestions = dialog.querySelector<HTMLElement>('[data-tt-search-suggestions]')!;
    const locale = dialog.dataset.locale || 'it';
    const msg = dialog.dataset;
    let timer: number | undefined;
    let run = 0;

    const render = async () => {
      const query = input.value.trim();
      const current = ++run;
      suggestions.hidden = query.length > 0;
      if (!query) { list.innerHTML = ''; status.textContent = ''; return; }
      let index: any[];
      try {
        if (!list.childElementCount) status.textContent = msg.loading || '';
        index = await loadIndex(locale);
      } catch {
        status.textContent = import.meta.env.DEV ? (msg.dev || '') : (msg.error || '');
        return;
      }
      if (current !== run) return;
      const { results, terms, total = 0, approximate } = search(index, query);
      list.innerHTML = results.map((r: any) => {
        const section = r.section;
        const sectionTitle = section?.h && section.h !== r.page.t ? section.h : '';
        const source = r.titleOnly ? (r.page.d || section?.x || '') : (section?.x || r.page.d || '');
        const more = r.more.map((s: any) => `<a href="${escapeHTML(resultHref(r.page, s))}">${highlight(s.h, terms)}</a>`).join('');
        return `<li class="tt-search-result">
          <p class="tt-search-kicker">${escapeHTML(r.page.k)}${sectionTitle ? ` <span aria-hidden="true">·</span> ${highlight(sectionTitle, terms)}` : ''}</p>
          <h2><a href="${escapeHTML(resultHref(r.page, section))}">${highlight(r.page.t, terms)}</a></h2>
          ${source ? `<p class="tt-search-snippet">${highlight(excerpt(source, terms), terms)}</p>` : ''}
          ${more ? `<p class="tt-search-more">${more}</p>` : ''}
        </li>`;
      }).join('');
      const count = total === 0 ? (msg.none || '').replace('{q}', query)
        : total === 1 ? (msg.one || '') : (msg.many || '').replace('{n}', String(total));
      status.textContent = approximate && total ? `${msg.approx} ${count}` : count;
    };

    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      input.focus();
      input.select();
      loadIndex(locale).catch(() => {});
    };
    const close = () => { if (dialog.open) dialog.close(); };

    const onInput = () => { window.clearTimeout(timer); timer = window.setTimeout(render, 90); };
    const onKey = (event: KeyboardEvent) => {
      const target = event.target as HTMLElement | null;
      const typing = target && (target.isContentEditable || /^(input|textarea|select)$/i.test(target.tagName));
      if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) { event.preventDefault(); open(); }
      else if (event.key === '/' && !typing && !event.altKey && !event.metaKey && !event.ctrlKey) { event.preventDefault(); open(); }
    };
    const onInputKey = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        // Nei campi di ricerca Chrome svuoterebbe il testo invece di chiudere.
        event.preventDefault();
        close();
        trigger.focus();
      } else if (event.key === 'Enter') {
        event.preventDefault();
        list.querySelector<HTMLAnchorElement>('.tt-search-result h2 a')?.click();
      } else if (event.key === 'ArrowDown') {
        const first = list.querySelector<HTMLAnchorElement>('a');
        if (first) { event.preventDefault(); first.focus(); }
      }
    };
    const onListKey = (event: KeyboardEvent) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      event.preventDefault();
      if (event.key === 'ArrowUp' && i === 0) input.focus();
      else links[Math.min(links.length - 1, Math.max(0, i + (event.key === 'ArrowDown' ? 1 : -1)))].focus();
    };
    const onClick = (event: MouseEvent) => {
      const el = event.target as HTMLElement;
      if (el === dialog) { close(); return; }                       // clic sullo sfondo
      if (el.closest('[data-tt-search-close]')) { close(); trigger.focus(); return; }
      const suggestion = el.closest<HTMLButtonElement>('[data-tt-search-suggest]');
      if (suggestion) { input.value = suggestion.dataset.ttSearchSuggest || ''; input.focus(); render(); return; }
      if (el.closest('a')) close();                                    // il link prosegue la navigazione
    };

    trigger.addEventListener('click', open);
    input.addEventListener('input', onInput);
    input.addEventListener('keydown', onInputKey);
    list.addEventListener('keydown', onListKey);
    dialog.addEventListener('click', onClick);
    document.addEventListener('keydown', onKey);
    cleanup = () => {
      trigger.removeEventListener('click', open);
      document.removeEventListener('keydown', onKey);
      if (dialog.open) dialog.close();
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>

<style is:global>
  /* Le regole generali del tema (button, input, li) usano anche !important:
     qui tutto è circoscritto a .tt-search-trigger e dialog.tt-search. */
  .site-head button.tt-search-trigger {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 10000;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: var(--tt-ink, var(--color-base)) !important;
    line-height: 1;
    cursor: pointer;
    opacity: .85;
    transition: opacity .2s ease;
  }
  .site-head button.tt-search-trigger:hover { opacity: 1; box-shadow: none; }
  .site-head button.tt-search-trigger:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; opacity: 1; }
  .site-head button.tt-search-trigger svg { display: block; }

  /* Desktop: la lente chiude la fila di destra (accessibilità · lingua · tema · cerca). */
  @media (min-width: 1601px) {
    .site-head button.tt-search-trigger { top: 50%; right: -10px; transform: translateY(-50%); }
    .site-head .site-head-right { padding-right: 40px; }
  }
  @media (min-width: 1101px) {
    .tt-editorial-shell .site-head button.tt-search-trigger { top: 50%; right: -10px; transform: translateY(-50%); }
    .tt-editorial-shell .site-head .site-head-right { padding-right: 40px; }
  }
  /* Menu a scomparsa: la lente resta in alto a destra, speculare al pulsante del menu. */
  @media (max-width: 1600px) {
    .site-wrapper:not(.tt-editorial-shell) .site-head button.tt-search-trigger { top: -2px; right: -8px; transform: none; }
  }
  @media (max-width: 1100px) {
    .tt-editorial-shell .site-head button.tt-search-trigger { top: 50%; right: -10px; transform: translateY(-50%); }
    .tt-editorial-shell.site-head-open .site-head button.tt-search-trigger { top: 0; transform: none; }
  }

  html:has(dialog.tt-search[open]) { overflow: hidden; }

  dialog.tt-search {
    --tt-search-paper: var(--tt-paper, var(--color-bg, #faf9f6));
    --tt-search-ink: var(--tt-ink, var(--color-base, #20201e));
    --tt-search-muted: var(--tt-muted, color-mix(in srgb, var(--tt-search-ink) 66%, transparent));
    --tt-search-line: var(--tt-line, color-mix(in srgb, var(--tt-search-ink) 16%, transparent));
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--tt-search-paper);
    color: var(--tt-search-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
    text-align: left;
  }
  dialog.tt-search::backdrop { background: transparent; }
  dialog.tt-search[open] { animation: tt-search-in .22s ease-out; }
  @keyframes tt-search-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { dialog.tt-search[open] { animation: none; } }

  dialog.tt-search *, dialog.tt-search *::before, dialog.tt-search *::after { box-sizing: border-box; }
  dialog.tt-search .tt-search-inner {
    width: min(920px, 100%);
    margin: 0 auto;
    padding: clamp(24px, 5vw, 64px) clamp(20px, 4vw, 48px) 80px;
  }
  dialog.tt-search .tt-search-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 0 0 10px; }
  dialog.tt-search .tt-search-label,
  dialog.tt-search .tt-search-kicker,
  dialog.tt-search button.tt-search-close,
  dialog.tt-search .tt-search-suggestions {
    font-family: var(--font-sans-serif);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  dialog.tt-search .tt-search-label { margin: 0; color: var(--tt-search-muted); }
  dialog.tt-search button.tt-search-close {
    display: inline-flex;
    align-items: center;
    height: auto;
    min-height: 44px;
    margin: 0;
    padding: 0 0 0 12px;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: var(--tt-search-ink) !important;
    cursor: pointer;
  }
  dialog.tt-search button.tt-search-close span { margin-left: 8px; font-size: 22px; font-weight: 300; line-height: 1; }
  dialog.tt-search button.tt-search-close:hover { box-shadow: none; text-decoration: underline; text-underline-offset: 4px; }

  dialog.tt-search input.tt-search-input {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    padding: 4px 0 14px;
    border: 0;
    border-bottom: 1px solid var(--tt-search-ink);
    border-radius: 0;
    outline: none;
    background: transparent;
    box-shadow: none;
    color: var(--tt-search-ink);
    font-family: var(--font-serif);
    font-size: clamp(32px, 5vw, 58px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -.02em;
    -webkit-appearance: none;
    appearance: none;
  }
  dialog.tt-search input.tt-search-input::placeholder { color: var(--tt-search-muted); opacity: .6; }
  dialog.tt-search input.tt-search-input:focus { border-color: var(--tt-search-ink); box-shadow: inset 0 -1px 0 var(--tt-search-ink); }
  dialog.tt-search input.tt-search-input::-webkit-search-cancel-button { display: none; }

  dialog.tt-search .tt-search-suggestions { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 18px; margin: 20px 0 0; color: var(--tt-search-muted); }
  dialog.tt-search .tt-search-suggestions[hidden] { display: none; }
  dialog.tt-search .tt-search-suggestions button {
    height: auto;
    margin: 0;
    padding: 6px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: var(--tt-search-ink) !important;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: underline;
    text-decoration-color: var(--tt-search-line);
    text-underline-offset: 5px;
    cursor: pointer;
  }
  dialog.tt-search .tt-search-suggestions button:hover { box-shadow: none; text-decoration-color: currentColor; }

  dialog.tt-search .tt-search-status { min-height: 1.4em; margin: 18px 0 10px; font-family: var(--font-sans-serif); font-size: 14px; line-height: 1.4; color: var(--tt-search-muted); }

  dialog.tt-search ol.tt-search-results { margin: 0; padding: 0; list-style: none; }
  dialog.tt-search li.tt-search-result { display: block; margin: 0; padding: 26px 0 28px; border-bottom: 1px solid var(--tt-search-line); }
  dialog.tt-search li.tt-search-result:first-child { border-top: 1px solid var(--tt-search-line); }
  dialog.tt-search li.tt-search-result::before { content: none; }
  dialog.tt-search .tt-search-kicker { margin: 0 0 10px; color: var(--tt-search-muted); }
  dialog.tt-search .tt-search-kicker span { margin: 0 4px; }
  dialog.tt-search .tt-search-result h2 {
    margin: 0;
    padding: 0;
    color: var(--tt-search-ink);
    font-family: var(--font-serif);
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -.015em;
    text-transform: none;
  }
  dialog.tt-search .tt-search-result h2 a { color: inherit; text-decoration: none; }
  dialog.tt-search .tt-search-result h2 a:hover,
  dialog.tt-search .tt-search-result h2 a:focus-visible { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  dialog.tt-search .tt-search-result a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  dialog.tt-search .tt-search-snippet { margin: 10px 0 0; font-family: var(--font-serif); font-size: 18px; line-height: 1.5; color: color-mix(in srgb, var(--tt-search-ink) 80%, transparent); }
  dialog.tt-search .tt-search-more { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 14px 0 0; font-family: var(--font-sans-serif); font-size: 14px; line-height: 1.4; }
  dialog.tt-search .tt-search-more a { color: var(--tt-search-ink); text-decoration: underline; text-decoration-color: var(--tt-search-line); text-underline-offset: 4px; }
  dialog.tt-search .tt-search-more a:hover { text-decoration-color: currentColor; }
  dialog.tt-search .tt-search-more a::before { content: '→\00a0'; display: inline-block; text-decoration: none; }
  dialog.tt-search mark { padding: 0 .08em; border-radius: 0; background: color-mix(in srgb, var(--tt-search-ink) 11%, transparent); color: inherit; }

  @media (max-width: 760px) {
    dialog.tt-search .tt-search-inner { padding-top: 14px; }
    dialog.tt-search .tt-search-snippet { font-size: 17px; }
    dialog.tt-search .tt-search-suggestions button { font-size: 18px; }
  }
</style>
