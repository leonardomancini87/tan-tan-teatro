---
const { entry } = Astro.props;
const data = entry.data as any;

import { renderRichText } from '../lib/cms-richtext';

const synopsisHtml = renderRichText(data.synopsis);
const accessibilityHtml = renderRichText(data.accessibility);
---

<h2>
  <i>{data.title}</i>{data.description ? `, di ${data.description}` : ''}
</h2>

{data.synopsis && (
  <>
    <h3 class="toc-only">Sinossi</h3>
    <div class="cms-richtext" set:html={synopsisHtml} />
  </>
)}

{data.credits?.length > 0 && (
  <>
    <h3 class="toc-only">Scheda artistica</h3>

    <div class="structured-credits">
      {data.credits.map((credit: any) => (
        <div class="structured-credit">
          <b>{credit.label}</b>: {credit.value}<br />
        </div>
      ))}
    </div>

    {(data.duration || data.thanks) && <br />}

    {data.duration && (
      <>
        Durata: {data.duration}<br />
      </>
    )}

    {data.thanks && (
      <>
        <i>Ringraziamenti</i>: {data.thanks}
      </>
    )}
  </>
)}

{data.trailer?.url && (
  <>
    <h3 class="toc-only">Trailer</h3>

    <div class="fluid-width-video-wrapper">
      <iframe
        src={data.trailer.url}
        title={data.trailer.title || `Trailer ${data.title}`}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </>
)}

{data.performances?.length > 0 && (
  <>
    <h3>Precedenti rappresentazioni</h3>

    <div class="structured-performances">
      {data.performances.map((performance: any) => (
        <div>
          {performance.date}: {
            performance.url ? (
              <a href={performance.url} target="_blank" rel="noopener noreferrer">
                {performance.name}
              </a>
            ) : (
              performance.name
            )
          }{performance.details ? `, ${performance.details}` : ''}<br />
        </div>
      ))}
    </div>
  </>
)}

{data.press?.length > 0 && (
  <>
    <h3>Rassegna stampa</h3>

    <p class="structured-press">
      {data.press.map((item: any, index: number) => (
        <>
          {index > 0 && '; '}
          {item.author}{item.author ? ', ' : ''}
          {item.url ? (
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              <i>{item.title}</i>
            </a>
          ) : (
            <i>{item.title}</i>
          )}
          {item.publication ? `, “${item.publication}”` : ''}
          {item.issue ? `, n. ${item.issue}` : ''}
          {item.date ? `, ${item.date}` : ''}
          {item.page ? `, p. ${item.page}` : ''}
        </>
      ))}
      .
    </p>
  </>
)}

{data.materials?.length > 0 && (
  <>
    <h3>Materiali</h3>

    <div class="materials-list">
      {data.materials.map((material: any) => (
        <a class="material-link" href={material.url} target="_blank" rel="noopener noreferrer">
          <span class="material-link__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M7 3.5h6.5L18 8v12.5H7V3.5Z" stroke="currentColor" stroke-width="1.4"></path>
              <path d="M13.5 3.5V8H18" stroke="currentColor" stroke-width="1.4"></path>
              <path d="M9.5 12h6M9.5 15h6M9.5 18h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
          </span>

          <span>
            <strong>{material.label}</strong>
            {material.kind && <small>{material.kind}</small>}
          </span>
        </a>
      ))}
    </div>
  </>
)}

{data.accessibility && (
  <>
    <h3>Accessibilità</h3>
    <div class="cms-richtext" set:html={accessibilityHtml} />
  </>
)}

<style>
  .structured-credit,
  .structured-performances > div {
    line-height: inherit;
  }

  .cms-richtext :global(p:first-child) {
    margin-top: 0;
  }

  .cms-richtext :global(p:last-child) {
    margin-bottom: 0;
  }

  .materials-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.15rem;
  }

  .material-link {
    display: inline-flex;
    align-items: center;
    gap: .7rem;
    text-decoration: none;
  }

  .material-link__icon {
    display: inline-flex;
  }

  .material-link span:last-child {
    display: flex;
    flex-direction: column;
  }

  .material-link small {
    display: block;
  }

  @media (min-width: 900px) {
    .materials-list {
      flex-wrap: nowrap;
      width: max-content;
      max-width: calc(100vw - 4rem);
    }

    .material-link {
      flex: 0 0 auto;
      white-space: nowrap;
    }
  }
</style>
