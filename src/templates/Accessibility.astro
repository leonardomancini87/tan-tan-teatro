---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';
import { ACCESSIBILITY_COPY, ACCESSIBILITY_LINKS, ACCESSIBILITY_PHOTOS } from '../data/accessibility.mjs';
import '../styles/accessibility-project.css';

interface Props {
  entry?: CollectionEntry<'pages'>;
  locale?: 'it' | 'en';
}

const { entry, locale: routeLocale } = Astro.props;
const locale = routeLocale ?? (entry?.data.locale === 'en' ? 'en' : 'it');
const c = ACCESSIBILITY_COPY[locale];
const photos = ACCESSIBILITY_PHOTOS;
const arrow = '→';
---

<Layout
  title={entry?.data.title ?? c.metaTitle}
  description={entry?.data.description ?? c.metaDescription}
  locale={locale}
  editorial={true}
  image={photos.hero.src}
>
  <article class="tt-editorial tt-accessibility" data-accessibility-version="project-v2-20260922" aria-labelledby="acc-title">
    <header class="acc-hero">
      <figure class="acc-hero-media">
        <img
          src={photos.hero.src}
          alt={photos.hero[locale]}
          width={photos.hero.width}
          height={photos.hero.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
      <div class="acc-hero-inner">
        <p class="acc-kicker">{c.eyebrow}</p>
        <h1 class="acc-title" id="acc-title">{c.title}</h1>
        <p class="acc-body">{c.intro}</p>
        <div class="acc-actions">
          <a class="tt-button tt-button--light" href="#etica">{c.heroPrimary} {arrow}</a>
          <a class="tt-text-link" href="#spettacoli-accessibili">{c.heroSecondary} {arrow}</a>
        </div>
      </div>
    </header>

    <section class="acc-shell acc-approach" id="approccio" aria-labelledby="acc-approach-title">
      <div class="acc-approach-copy">
        <p class="acc-kicker">{c.approachLabel}</p>
        <h2 class="acc-heading" id="acc-approach-title">{c.approachTitle}</h2>
        <p class="acc-body">{c.approachText}</p>
      </div>
      <figure>
        <img src={photos.approach.src} alt={photos.approach[locale]} width={photos.approach.width} height={photos.approach.height} loading="lazy" decoding="async" />
      </figure>
    </section>

    <section class="acc-tools" id="strumenti" aria-labelledby="acc-tools-title">
      <div class="acc-shell">
        <div class="acc-section-head">
          <p class="acc-kicker">{c.toolsLabel}</p>
          <h2 class="acc-heading" id="acc-tools-title">{c.toolsTitle}</h2>
        </div>
        <div class="acc-tool-grid">
          {c.tools.map((tool) => (
            <section class="acc-tool">
              <h3>{tool.title}</h3>
              <p>{tool.text}</p>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="acc-projects" aria-label={locale === 'it' ? 'ETICA e Sténtor' : 'ETICA and Sténtor'}>
      <div class="acc-shell acc-project-grid">
        <section class="acc-project" id="etica" aria-labelledby="acc-etica-title">
          <p class="acc-kicker">{c.eticaLabel}</p>
          <p class="acc-project-name">{c.eticaName}</p>
          <h2 class="acc-project-subtitle" id="acc-etica-title">{c.eticaTitle}</h2>
          <p class="acc-body">{c.eticaText}</p>
          <a
            class="tt-text-link"
            href={ACCESSIBILITY_LINKS.etica}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${c.eticaLink} (${c.external})`}
          >{c.eticaLink} {arrow}</a>
        </section>

        <section class="acc-project" id="stentor" aria-labelledby="acc-stentor-title">
          <p class="acc-kicker">{c.stentorLabel}</p>
          <p class="acc-project-name">{c.stentorName}</p>
          <h2 class="acc-project-subtitle" id="acc-stentor-title">{c.stentorTitle}</h2>
          <p class="acc-body">{c.stentorText}</p>
          <ul class="acc-stentor-points">
            {c.stentorPoints.map((item) => <li>{item}</li>)}
          </ul>
          <a
            class="tt-text-link"
            href={ACCESSIBILITY_LINKS.stentor}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${c.stentorLink} (${c.external})`}
          >{c.stentorLink} {arrow}</a>
        </section>
      </div>
    </section>

    <section class="acc-shell acc-shows" id="spettacoli-accessibili" aria-labelledby="acc-shows-title">
      <p class="acc-kicker">{c.showsLabel}</p>
      <h2 class="acc-heading" id="acc-shows-title">{c.showsTitle}</h2>
      <p class="acc-body acc-shows-intro">{c.showsIntro}</p>
      <div class="acc-show-grid">
        {c.shows.map((show) => {
          const photo = photos[show.photo];
          return (
            <article class="acc-show-card">
              <figure>
                <img src={photo.src} alt={photo[locale]} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
              </figure>
              <div class="acc-show-copy">
                <h3>{show.title}</h3>
                <p class="acc-show-author">{show.author}</p>
                <p class="acc-small">{show.text}</p>
                <a class="tt-text-link" href={show.href}>{show.link} {arrow}</a>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <section class="acc-journey" id="prima-durante-dopo" aria-labelledby="acc-journey-title">
      <div class="acc-shell">
        <p class="acc-kicker">{c.journeyLabel}</p>
        <h2 class="acc-heading" id="acc-journey-title">{c.journeyTitle}</h2>
        <div class="acc-journey-grid">
          {c.journey.map((step) => (
            <section class="acc-journey-card">
              <h3>{step.title}</h3>
              <ul>{step.items.map((item) => <li>{item}</li>)}</ul>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section class="acc-shell acc-upcoming" id="prossimi-appuntamenti-accessibili" aria-labelledby="acc-upcoming-title">
      <div>
        <p class="acc-kicker">{c.upcomingLabel}</p>
        <h2 class="acc-heading" id="acc-upcoming-title">{c.upcomingTitle}</h2>
      </div>
      <div>
        <p class="acc-body">{c.upcomingText}</p>
        <a class="tt-button tt-button--outline" href={ACCESSIBILITY_LINKS.appointments[locale]}>{c.upcomingLink} {arrow}</a>
      </div>
    </section>

    <section class="acc-shell acc-research" id="ricerca-in-corso" aria-labelledby="acc-research-title">
      <figure>
        <img src={photos.research.src} alt={photos.research[locale]} width={photos.research.width} height={photos.research.height} loading="lazy" decoding="async" />
      </figure>
      <div class="acc-research-copy">
        <p class="acc-kicker">{c.researchLabel}</p>
        <h2 class="acc-heading" id="acc-research-title">{c.researchTitle}</h2>
        <p class="acc-body">{c.researchText}</p>
        <ul class="acc-research-list">
          {c.researchItems.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="acc-contact" id="contatti-accessibilita" aria-labelledby="acc-contact-title">
      <div class="acc-shell acc-contact-inner">
        <div>
          <p class="acc-kicker">{c.contactLabel}</p>
          <h2 class="acc-heading" id="acc-contact-title">{c.contactTitle}</h2>
          <p class="acc-body">{c.contactText}</p>
          <a class="acc-email" href={ACCESSIBILITY_LINKS.contact}>accessibilita@tantanteatro.it</a>
        </div>
        <a class="tt-button tt-button--light" href={ACCESSIBILITY_LINKS.contact}>{c.contactLink} {arrow}</a>
      </div>
    </section>
  </article>
</Layout>
