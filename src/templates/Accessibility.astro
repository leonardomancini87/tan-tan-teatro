---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const currentLocale = entry.data.locale ?? 'it';
const title = entry.data.title;
const description = entry.data.description;

const isEnglish = currentLocale === 'en';

const content = isEnglish
  ? {
      kicker: 'Tan Tan Teatro',
      title: 'Accessibility',
      lede: 'Before, during and after the performance.',
      intro:
        'Information and resources to learn about our performances, know in advance what to expect in the theatre and discover the accessibility services available.',

      index: 'Index',
      indexExpect: 'What to expect',
      indexBefore: 'Before entering the theatre',
      indexServices: 'Audio description and surtitles',
      indexInfo: 'Information and requests',

      expectTitle: 'What to expect',
      expectText:
        'For each performance, we aim to provide information in advance about its duration, possible intervals, the use of lighting, music and loud sounds, and other elements that may help audiences prepare for the performance. Specific information may vary from one production to another and is provided on the relevant pages when necessary.',

      beforeTitle: 'Before entering the theatre',
      beforeText:
        'For information about the venue, seating and available services, you can contact the theatre staff. Whenever possible, we provide information in advance about access to the venue and ways of experiencing the performance. If you have specific requirements, we recommend contacting us before the performance.',

      servicesTitle: 'Audio description and surtitles',
      servicesBeforeLink:
        'Our performances offer audio description in Italian and surtitles in Italian, English and French. Accessible content is delivered through',
      servicesAfterLink:
        ', a platform developed as part of the University of Turin public engagement project “Etica. Esplorazioni Teatrali e Innovazione per una Cultura Accessibile”.',

      infoTitle: 'Information and requests',
      infoBeforeEmail:
        'For information about audio description, surtitles, accessible materials or other specific requirements, please write to',
    }
  : {
      kicker: 'Tan Tan Teatro',
      title: 'Accessibilità',
      lede: 'Prima, durante e dopo lo spettacolo.',
      intro:
        'Informazioni e materiali utili per conoscere gli spettacoli, sapere in anticipo cosa accadrà in sala e scoprire i servizi di accessibilità disponibili.',

      index: 'Indice',
      indexExpect: 'Cosa aspettarsi',
      indexBefore: 'Prima di entrare in sala',
      indexServices: 'Audiodescrizioni e sopratitoli',
      indexInfo: 'Informazioni e richieste',

      expectTitle: 'Cosa aspettarsi',
      expectText:
        "Per ogni spettacolo cerchiamo di rendere disponibili in anticipo informazioni utili sulla durata, sull'eventuale presenza di intervalli, sull'uso di luci, musica e suoni intensi e su altri elementi che possano aiutare il pubblico a prepararsi alla visione. Le informazioni specifiche possono variare da uno spettacolo all'altro e vengono indicate nelle rispettive pagine quando necessarie.",

      beforeTitle: 'Prima di entrare in sala',
      beforeText:
        "Per informazioni sulla sala, sui posti e sui servizi disponibili è possibile rivolgersi al personale di accoglienza nei teatri. Quando possibile, cerchiamo di fornire in anticipo indicazioni utili sull'accesso agli spazi e sulle modalità di fruizione degli spettacoli. Per necessità specifiche consigliamo di contattarci prima delle rappresentazioni.",

      servicesTitle: 'Audiodescrizioni e sopratitoli',
      servicesBeforeLink:
        'Per gli spettacoli sono disponibili audiodescrizioni in italiano e sopratitoli in italiano, inglese e francese. I contenuti accessibili vengono fruiti tramite',
      servicesAfterLink:
        ", una piattaforma sviluppata nell'ambito del progetto di public engagement dell'Università degli Studi di Torino “Etica. Esplorazioni Teatrali e Innovazione per una Cultura Accessibile”.",

      infoTitle: 'Informazioni e richieste',
      infoBeforeEmail:
        'Per informazioni su audiodescrizioni, sopratitoli, materiali accessibili o altre necessità specifiche, scrivere a',
    };
---

<Layout title={title} description={description} locale={currentLocale}>
  <article class="accessibility-page" aria-labelledby="accessibility-title">
    <header class="accessibility-hero">
      <p class="accessibility-kicker">{content.kicker}</p>

      <h1 id="accessibility-title">{content.title}</h1>

      <p class="accessibility-lede">
        {content.lede}
      </p>

      <p class="accessibility-intro">
        {content.intro}
      </p>
    </header>

    <section class="accessibility-tools" aria-labelledby="tools-title">
      <h2 id="tools-title">{content.index}</h2>

      <div class="accessibility-tools-grid">
        <a href="#cosa-aspettarsi">
          <span aria-hidden="true">01</span>
          <strong>{content.indexExpect}</strong>
        </a>

        <a href="#prima-della-sala">
          <span aria-hidden="true">02</span>
          <strong>{content.indexBefore}</strong>
        </a>

        <a href="#servizi-accessibili">
          <span aria-hidden="true">03</span>
          <strong>{content.indexServices}</strong>
        </a>

        <a href="#informazioni">
          <span aria-hidden="true">04</span>
          <strong>{content.indexInfo}</strong>
        </a>
      </div>
    </section>

    <section
      id="cosa-aspettarsi"
      class="accessibility-reading-section"
      aria-labelledby="expectations-title"
    >
      <h2 id="expectations-title">{content.expectTitle}</h2>

      <p>
        {content.expectText}
      </p>
    </section>

    <section
      id="prima-della-sala"
      class="accessibility-reading-section accessibility-note"
    >
      <h2>{content.beforeTitle}</h2>

      <p>
        {content.beforeText}
      </p>
    </section>

    <section
      id="servizi-accessibili"
      class="accessibility-reading-section"
      aria-labelledby="services-title"
    >
      <h2 id="services-title">{content.servicesTitle}</h2>

      <p>
        {content.servicesBeforeLink}
        {' '}
        <a
          href="https://www.stentor.live/it/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Sténtor
        </a>
        {content.servicesAfterLink}
      </p>
    </section>

    <section
      id="informazioni"
      class="accessibility-contact"
      aria-labelledby="contact-title"
    >
      <h2 id="contact-title">{content.infoTitle}</h2>

      <p>
        {content.infoBeforeEmail}
        {' '}
        <a href="mailto:accessibilita@tantanteatro.it">
          accessibilita@tantanteatro.it
        </a>.
      </p>
    </section>
  </article>

  <style>
    .accessibility-page {
      width: min(1120px, 100%);
      margin: 0 auto;
      padding: 1vw 0 1vw;
      font-size: 1.9rem;
      line-height: 1.55;
    }

    .accessibility-page h1,
    .accessibility-page h2,
    .accessibility-page p {
      color: var(--color-base);
    }

    .accessibility-page h1 {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(5.2rem, 9vw, 12rem);
      font-weight: var(--font-normal);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }

    .accessibility-page h2 {
      margin: 0 0 1.4rem;
      font-family: var(--font-serif);
      font-size: clamp(3.2rem, 4vw, 5.4rem);
      font-weight: var(--font-normal);
      line-height: 1;
      letter-spacing: -0.03em;
    }

    .accessibility-page p {
      margin: 0 0 1.2rem;
    }

    .accessibility-kicker {
      margin: 0 0 1.2rem !important;
      font-family: var(--font-sans-serif);
      font-size: 1.25rem;
      font-variant: small-caps;
      text-transform: lowercase;
      letter-spacing: 0.18em;
      opacity: 0.58;
    }

    .accessibility-hero {
      display: grid;
      grid-template-columns:
        minmax(0, 1.15fr)
        minmax(280px, 0.85fr);
      gap: 3rem 6rem;
      align-items: end;
      padding: 4vw 0 4vw;
      border-bottom: 1px solid var(--color-border);
    }

    .accessibility-hero .accessibility-kicker,
    .accessibility-hero h1 {
      grid-column: 1 / -1;
    }

    .accessibility-lede {
      font-family: var(--font-serif);
      font-size: clamp(3rem, 4vw, 5.2rem);
      line-height: 1.02;
      letter-spacing: -0.03em;
    }

    .accessibility-intro {
      align-self: end;
      max-width: 34rem;
      font-family: var(--font-serif);
      font-size: 2.1rem;
      opacity: 0.76;
    }

    .accessibility-tools {
      margin: 3rem 0 6rem;
      padding: 2.4rem;
      color: #fff;
      background: #111;
      border-radius: 10px;
    }

    .accessibility-tools h2 {
      margin-bottom: 1.4rem;
      color: #fff;
      font-family: var(--font-sans-serif);
      font-size: 1.45rem;
      font-variant: small-caps;
      font-weight: var(--font-normal);
      letter-spacing: 0.12em;
      text-transform: lowercase;
    }

    .accessibility-tools-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
    }

    .accessibility-tools-grid a {
      display: flex;
      align-items: center;
      gap: 1.1rem;
      min-height: 5.8rem;
      padding: 0 1.8rem;
      color: #fff;
      background: transparent;
      border-right: 1px solid rgba(255, 255, 255, 0.28);
      border-radius: 0;
      font-family: var(--font-sans-serif);
      font-size: 1.55rem;
      line-height: 1.2;
      text-align: left;
      text-decoration: none;
    }

    .accessibility-tools-grid a:last-child {
      border-right: 0;
    }

    .accessibility-tools-grid a:hover,
    .accessibility-tools-grid a:focus {
      background: rgba(255, 255, 255, 0.12);
      text-decoration: none;
    }

    .accessibility-tools-grid span {
      min-width: 2.2rem;
      font-family: var(--font-serif);
      font-size: 2.6rem;
      line-height: 1;
    }

    .accessibility-tools-grid strong {
      font-weight: var(--font-normal);
    }

    .accessibility-reading-section,
    .accessibility-contact {
      max-width: 720px;
      margin: 6rem auto;
    }

    .accessibility-reading-section p,
    .accessibility-contact p {
      font-size: 2.15rem;
      line-height: 1.62;
    }

    .accessibility-reading-section a,
    .accessibility-reading-section a:visited,
    .accessibility-contact a,
    .accessibility-contact a:visited {
      color: var(--color-base);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .accessibility-note {
      padding: 2.8rem;
      background: rgba(0, 0, 0, 0.035);
      border-radius: 10px;
    }

    .accessibility-contact {
      padding-top: 4rem;
      border-top: 1px solid var(--color-border);
    }

    [data-theme='dark'] .accessibility-note {
      background: rgba(255, 255, 255, 0.06);
    }

    @media (max-width: 980px) {
      .accessibility-hero {
        grid-template-columns: 1fr;
        padding: 5rem 0 4rem;
      }

      .accessibility-tools-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .accessibility-tools-grid a:nth-child(2) {
        border-right: 0;
      }

      .accessibility-tools-grid a:nth-child(1),
      .accessibility-tools-grid a:nth-child(2) {
        border-bottom: 1px solid rgba(255, 255, 255, 0.28);
      }
    }

    @media (max-width: 640px) {
      .accessibility-page {
        font-size: 1.75rem;
        padding-top: 0;
      }

      .accessibility-hero {
        padding: 3.5rem 0 3rem;
      }

      .accessibility-tools {
        padding: 1.4rem;
      }

      .accessibility-tools-grid {
        grid-template-columns: 1fr;
      }

      .accessibility-tools-grid a {
        padding: 1.3rem 0;
        border-right: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.28);
      }

      .accessibility-tools-grid a:last-child {
        border-bottom: 0;
      }

      .accessibility-reading-section p,
      .accessibility-contact p {
        font-size: 1.9rem;
      }
    }
  </style>
</Layout>