---
import Layout from '../layouts/Layout.astro';
import CalendarRuntime from '../components/CalendarRuntime.astro';
import HeroRuntime from '../components/HeroRuntime.astro';
import '../styles/home-agenda-landscape.css';
import { type CollectionEntry } from 'astro:content';
import { renderHome } from '../lib/homepage.mjs';
interface Props { entry: CollectionEntry<'pages'>; }
const { entry } = Astro.props;
const locale = entry.data.locale ?? 'it';
---
<Layout title={entry.data.title} description={entry.data.description} locale={locale} editorial={true} image="/img/matrimonio01.jpg">
  <Fragment set:html={renderHome(locale)} />
  <CalendarRuntime />
  <HeroRuntime />
</Layout>
