{
  "rewrites": [
    {
      "source": "/iscrizioni/:slug",
      "destination": "/iscrizioni/index.html"
    },
    {
      "source": "/lab/:code",
      "destination": "/lab/index.html"
    },
    {
      "source": "/sondaggio/:code",
      "destination": "/sondaggio/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/news/:slug",
      "destination": "/appuntamenti",
      "permanent": true
    },
    {
      "source": "/sold",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sold/:slug",
      "destination": "/",
      "permanent": true
    }
  ]
}
